APP_ENV=development
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
RELAY_API_URL=http://127.0.0.1:8080
LOCAL_UID=1000
LOCAL_GID=1000

# Samvaad / Sarvam Voice Agents: configure these in the root .env
SARVAM_API_BASE_URL=https://apps.sarvam.ai
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
SARVAM_API_KEY_FILE=./secrets/sarvam_api_key
# Base callback URL; the backend appends a unique secret per call.
SARVAM_WEBHOOK_URL=
# Enable only after confirming HTTPS routing and redaction of callback URLs.
SARVAM_WEBHOOK_ENABLED=false
DEMO_CALL_PHONE_NUMBER=
DEMO_CLINICIAN_PASSWORD_FILE=./secrets/demo_clinician_password
DEMO_COORDINATOR_PASSWORD_FILE=./secrets/demo_coordinator_password
